# Normalize line endings: everything text is committed with LF and checked
# out as LF on every platform, so Windows clones (core.autocrlf=true) don't
# fail the incremental prettier --check CI gate on CRLF.
* text=auto eol=lf

# Binary assets — never normalized or diffed as text.
*.docx binary
*.xlsx binary
*.pptx binary
*.pdf binary
*.png binary
*.ico binary
*.icns binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary

# Template font license texts ship byte-identical to the distributors' files.
packages/ui/template-fonts/*.txt -text

# Offline browser resources are generated from reviewed TypeScript and vendor sources.
apps/ipad/EveryOffice/Resources/*Editor/index.html -diff -whitespace
apps/ipad/EveryOffice/Resources/Notices/NOTICE -whitespace
# Preserve redistributed engine files and licence texts byte for byte.
apps/ipad-sheets/vendor/ironcalc-xlsx/** -text -whitespace
apps/ipad/licenses/*.txt -text -whitespace
apps/ipad/EveryOffice/Resources/Notices/NOTICE -text
