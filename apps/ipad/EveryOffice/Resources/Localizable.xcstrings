    "The editor is missing. Rebuild the app with its document resources.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The editor is missing. Rebuild the app with its document resources."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "편집기가 없습니다. 문서 리소스를 포함하여 앱을 다시 빌드하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エディタがありません。書類リソースを含めてアプリを再ビルドしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "缺少编辑器。请包含文档资源后重新构建 App。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "缺少編輯器。請包含文件資源後重新建置 App。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’éditeur est manquant. Recompilez l’app avec ses ressources de documents."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Editor fehlt. Erstelle die App mit ihren Dokumentressourcen erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Falta el editor. Vuelve a compilar la app con sus recursos de documentos."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O editor está ausente. Recompile o app com seus recursos de documentos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’editor è assente. Ricompila l’app includendo le risorse dei documenti."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De editor ontbreekt. Bouw de app opnieuw met de documentbronnen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak edytora. Zbuduj aplikację ponownie z zasobami dokumentów."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Chybí editor. Sestavte aplikaci znovu včetně zdrojů dokumentů."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Редактор отсутствует. Пересоберите приложение с ресурсами документов."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Editor tidak ditemukan. Bangun ulang app dengan sumber daya dokumennya."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Editor tiada. Bina semula app dengan sumber dokumennya."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المحرر مفقود. أعد بناء التطبيق مع موارد المستندات."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "העורך חסר. יש לבנות מחדש את היישום עם משאבי המסמכים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एडिटर मौजूद नहीं है। दस्तावेज़ संसाधनों के साथ ऐप फिर से बनाएँ।"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่พบตัวแก้ไข โปรดสร้างแอปใหม่พร้อมทรัพยากรเอกสาร"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thiếu trình chỉnh sửa. Hãy dựng lại ứng dụng kèm tài nguyên tài liệu."
          }
        }
      }
    },
    "The editor stopped. Reopen the document to restore the last saved version.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The editor stopped. Reopen the document to restore the last saved version."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "편집기가 중지되었습니다. 문서를 다시 열어 마지막 저장본을 복원하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エディタが停止しました。書類を開き直して最後に保存した内容を復元してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "编辑器已停止。重新打开文档以恢复上次保存的版本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "編輯器已停止。重新打開文件以回復上次儲存的版本。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’éditeur s’est arrêté. Rouvrez le document pour retrouver la dernière version enregistrée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Editor wurde beendet. Öffne das Dokument erneut, um den zuletzt gespeicherten Stand wiederherzustellen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El editor se ha detenido. Abre de nuevo el documento para recuperar la última versión guardada."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O editor parou. Abra o documento novamente para recuperar a última versão salva."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’editor si è arrestato. Riapri il documento per ripristinare l’ultima versione salvata."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De editor is gestopt. Open het document opnieuw om de laatst bewaarde versie te herstellen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Edytor został zatrzymany. Otwórz dokument ponownie, aby przywrócić ostatnią zapisaną wersję."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Editor se zastavil. Obnovením dokumentu načtete poslední uloženou verzi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Редактор остановлен. Откройте документ заново, чтобы восстановить последнюю сохранённую версию."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Editor berhenti. Buka kembali dokumen untuk memulihkan versi terakhir yang disimpan."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Editor terhenti. Buka semula dokumen untuk memulihkan versi terakhir yang disimpan."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "توقف المحرر. أعد فتح المستند لاستعادة آخر نسخة محفوظة."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "העורך נעצר. יש לפתוח את המסמך מחדש כדי לשחזר את הגרסה האחרונה שנשמרה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एडिटर रुक गया। अंतिम सहेजा गया संस्करण बहाल करने के लिए दस्तावेज़ फिर से खोलें।"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตัวแก้ไขหยุดทำงาน เปิดเอกสารอีกครั้งเพื่อกู้คืนเวอร์ชันที่บันทึกล่าสุด"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trình chỉnh sửa đã dừng. Mở lại tài liệu để khôi phục phiên bản lưu gần nhất."
          }
        }
      }
    },
    "The file you imported from Files will stay unchanged.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file you imported from Files will stay unchanged."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일 앱에서 가져온 원본은 변경되지 않습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルから読み込んだ元の書類は変更されません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从“文件”导入的原始文件不会更改。"
