    "No AI service, account, or analytics is connected in this iPad app.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No AI service, account, or analytics is connected in this iPad app."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 iPad 앱에는 AI 서비스, 계정, 사용 통계가 연결되어 있지 않습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このiPadアプリにはAIサービス、アカウント、利用状況分析の接続はありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 iPad App 未连接 AI 服务、账号或分析服务。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此 iPad App 未連接 AI 服務、帳號或分析服務。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun service d’IA, compte ni outil d’analyse n’est connecté à cette app iPad."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese iPad-App ist mit keinem KI-Dienst, Konto oder Analysedienst verbunden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta app para iPad no está conectada a servicios de IA, cuentas ni analítica."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este app para iPad não está conectado a serviços de IA, contas ou análises."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa app per iPad non è collegata a servizi IA, account o analisi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze iPad-app is niet verbonden met AI-diensten, accounts of analyses."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta aplikacja na iPada nie łączy się z usługami AI, kontami ani analityką."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tato aplikace pro iPad není připojena ke službám AI, účtům ani analytice."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это приложение для iPad не подключено к службам ИИ, аккаунтам или аналитике."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "App iPad ini tidak terhubung ke layanan AI, akun, atau analitik."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "App iPad ini tidak disambungkan kepada perkhidmatan AI, akaun atau analitis."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يرتبط تطبيق iPad هذا بأي خدمة ذكاء اصطناعي أو حساب أو تحليلات."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יישום זה ל-iPad אינו מחובר לשירות AI, לחשבון או לניתוח שימוש."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस iPad ऐप से कोई AI सेवा, खाता या विश्लेषण सेवा नहीं जुड़ी है।"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แอป iPad นี้ไม่ได้เชื่อมต่อบริการ AI บัญชี หรือบริการวิเคราะห์"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ứng dụng iPad này không kết nối dịch vụ AI, tài khoản hoặc phân tích."
          }
        }
      }
    },
