    "Your files stay on this iPad unless you share them.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your files stay on this iPad unless you share them."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공유하기 전까지 파일은 이 iPad에 보관됩니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有しない限り、ファイルはこのiPadに保存されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "除非你主动分享，否则文件保留在此 iPad 上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "除非你主動分享，否則檔案保留在此 iPad 上。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos fichiers restent sur cet iPad tant que vous ne les partagez pas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Dateien bleiben auf diesem iPad, bis du sie teilst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus archivos permanecen en este iPad salvo que los compartas."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus arquivos ficam neste iPad, a menos que você os compartilhe."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi file rimangono su questo iPad finché non li condividi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je bestanden blijven op deze iPad totdat je ze deelt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pliki pozostają na tym iPadzie, dopóki ich nie udostępnisz."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Soubory zůstávají na tomto iPadu, dokud je nesdílíte."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файлы остаются на этом iPad, пока вы ими не поделитесь."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "File tetap di iPad ini kecuali Anda membagikannya."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Fail anda kekal pada iPad ini melainkan anda berkongsinya."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبقى ملفاتك على هذا iPad ما لم تشاركها."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקבצים נשארים ב-iPad הזה עד שתבחרו לשתף אותם."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब तक आप साझा न करें, आपकी फ़ाइलें इस iPad पर रहती हैं।"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไฟล์จะอยู่บน iPad เครื่องนี้จนกว่าคุณจะแชร์"
