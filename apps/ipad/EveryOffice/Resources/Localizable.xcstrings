    "Save this document before deleting its local copy.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save this document before deleting its local copy."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로컬 사본을 삭제하기 전에 문서를 저장하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカルコピーを削除する前に書類を保存してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除本地副本前，请先保存文档。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "刪除本機副本前，請先儲存文件。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez ce document avant de supprimer sa copie locale."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speichere dieses Dokument, bevor du seine lokale Kopie löschst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda este documento antes de eliminar su copia local."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Salve este documento antes de apagar sua cópia local."
          }
