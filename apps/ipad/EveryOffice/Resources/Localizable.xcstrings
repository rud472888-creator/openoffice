        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप मूल फ़ाइल निर्यात करके दूसरे ऐप में खोल सकते हैं।"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
