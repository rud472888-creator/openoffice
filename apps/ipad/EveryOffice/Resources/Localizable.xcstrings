    "You can export the original file and open it in another app.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can export the original file and open it in another app."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원본 파일을 내보내 다른 앱에서 열 수 있습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "元のファイルを書き出して別のアプリで開けます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你可以导出原始文件，并在其他 App 中打开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你可以輸出原始檔案，並在其他 App 中打開。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez exporter le fichier d’origine et l’ouvrir dans une autre app."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst die Originaldatei exportieren und in einer anderen App öffnen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes exportar el archivo original y abrirlo en otra app."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode exportar o arquivo original e abri-lo em outro app."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi esportare il file originale e aprirlo in un’altra app."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kunt het oorspronkelijke bestand exporteren en in een andere app openen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Możesz wyeksportować oryginalny plik i otworzyć go w innej aplikacji."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Původní soubor můžete exportovat a otevřít v jiné aplikaci."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Можно экспортировать исходный файл и открыть его в другом приложении."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda dapat mengekspor file asli dan membukanya di app lain."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda boleh mengeksport fail asal dan membukanya dalam app lain."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك تصدير الملف الأصلي وفتحه في تطبيق آخر."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אפשר לייצא את הקובץ המקורי ולפתוח אותו ביישום אחר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप मूल फ़ाइल निर्यात करके दूसरे ऐप में खोल सकते हैं।"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณสามารถส่งออกไฟล์ต้นฉบับและเปิดในแอปอื่นได้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có thể xuất tệp gốc và mở trong ứng dụng khác."
          }
        }
      }
    },
    "Your files stay on this iPad unless you share them.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your files stay on this iPad unless you share them."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공유하기 전까지 파일은 이 iPad에 보관됩니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有しない限り、ファイルはこのiPadに保存されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "除非你主动分享，否则文件保留在此 iPad 上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "除非你主動分享，否則檔案保留在此 iPad 上。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos fichiers restent sur cet iPad tant que vous ne les partagez pas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Dateien bleiben auf diesem iPad, bis du sie teilst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus archivos permanecen en este iPad salvo que los compartas."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus arquivos ficam neste iPad, a menos que você os compartilhe."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi file rimangono su questo iPad finché non li condividi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je bestanden blijven op deze iPad totdat je ze deelt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pliki pozostają na tym iPadzie, dopóki ich nie udostępnisz."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Soubory zůstávají na tomto iPadu, dokud je nesdílíte."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файлы остаются на этом iPad, пока вы ими не поделитесь."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "File tetap di iPad ini kecuali Anda membagikannya."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Fail anda kekal pada iPad ini melainkan anda berkongsinya."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبقى ملفاتك على هذا iPad ما لم تشاركها."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקבצים נשארים ב-iPad הזה עד שתבחרו לשתף אותם."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब तक आप साझा न करें, आपकी फ़ाइलें इस iPad पर रहती हैं।"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไฟล์จะอยู่บน iPad เครื่องนี้จนกว่าคุณจะแชร์"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tệp vẫn ở trên iPad này trừ khi bạn chia sẻ."
          }
        }
      }
    },
