    "The PDF could not be prepared. Try exporting fewer pages.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The PDF could not be prepared. Try exporting fewer pages."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "PDF를 준비할 수 없습니다. 페이지 수를 줄여서 내보내세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "PDFを準備できません。ページ数を減らして書き出してください。"
