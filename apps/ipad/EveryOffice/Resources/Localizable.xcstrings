    "Import a file or create a note to get started.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Import a file or create a note to get started."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일을 가져오거나 메모를 만들어 시작하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルを読み込むか、メモを作成してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导入文件或创建笔记以开始使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輸入檔案或建立筆記以開始使用。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Importez un fichier ou créez une note pour commencer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Importiere eine Datei oder erstelle eine Notiz."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Importa un archivo o crea una nota para empezar."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Importe um arquivo ou crie uma nota para começar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Importa un file o crea una nota per iniziare."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Importeer een bestand of maak een notitie om te beginnen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaimportuj plik lub utwórz notatkę, aby rozpocząć."
          }
        },
        "cs": {
