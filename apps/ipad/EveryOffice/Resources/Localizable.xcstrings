    "Preview only. Editing this format is not available on iPad.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preview only. Editing this format is not available on iPad."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "미리보기 전용입니다. 이 형식은 iPad에서 편집할 수 없습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プレビュー専用です。この形式はiPadで編集できません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅供预览。iPad 不支持编辑此格式。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅供預覽。iPad 不支援編輯此格式。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperçu uniquement. Ce format ne peut pas être modifié sur iPad."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur Vorschau. Dieses Format kann auf dem iPad nicht bearbeitet werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo vista previa. Este formato no se puede editar en el iPad."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Somente pré-visualização. Este formato não pode ser editado no iPad."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo anteprima. Questo formato non è modificabile su iPad."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen voorvertoning. Dit formaat kan niet op de iPad worden bewerkt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tylko podgląd. Tego formatu nie można edytować na iPadzie."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pouze náhled. Tento formát nelze na iPadu upravovat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только просмотр. Редактирование этого формата на iPad недоступно."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya pratinjau. Format ini tidak dapat diedit di iPad."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pratonton sahaja. Format ini tidak boleh diedit pada iPad."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "للمعاينة فقط. لا يتوفر تحرير هذا التنسيق على iPad."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תצוגה מקדימה בלבד. לא ניתן לערוך פורמט זה ב-iPad."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल पूर्वावलोकन। iPad पर इस प्रारूप का संपादन उपलब्ध नहीं है।"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แสดงตัวอย่างเท่านั้น ไม่สามารถแก้ไขรูปแบบนี้บน iPad ได้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ xem trước. Không thể sửa định dạng này trên iPad."
          }
        }
      }
    },
