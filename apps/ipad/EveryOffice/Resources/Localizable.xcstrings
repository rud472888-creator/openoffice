    "Documents are stored locally. Import makes a copy. Export shares a copy.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Documents are stored locally. Import makes a copy. Export shares a copy."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "문서는 기기에 저장됩니다. 가져오기와 내보내기는 사본을 만듭니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "書類は端末に保存されます。読み込みと書き出しではコピーを作成します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文档存储在本地。导入和导出均使用副本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "文件儲存在本機。輸入和輸出均使用副本。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les documents sont stockés localement. L’importation et l’exportation créent des copies."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dokumente werden lokal gespeichert. Import und Export erstellen Kopien."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los documentos se guardan localmente. Importar y exportar crea copias."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os documentos são armazenados localmente. Importar e exportar cria cópias."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I documenti vengono salvati localmente. L’importazione e l’esportazione creano copie."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Documenten worden lokaal bewaard. Importeren en exporteren maakt kopieën."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dokumenty są przechowywane lokalnie. Import i eksport tworzą kopie."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dokumenty se ukládají místně. Import a export vytvářejí kopie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Документы хранятся локально. Импорт и экспорт создают копии."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dokumen disimpan secara lokal. Impor dan ekspor membuat salinan."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dokumen disimpan secara setempat. Import dan eksport menghasilkan salinan."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُخزّن المستندات محليًا. ينشئ الاستيراد والتصدير نسخًا."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המסמכים נשמרים מקומית. ייבוא וייצוא יוצרים עותקים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दस्तावेज़ स्थानीय रूप से सहेजे जाते हैं। आयात और निर्यात कॉपियाँ बनाते हैं।"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เอกสารถูกเก็บไว้ในเครื่อง การนำเข้าและส่งออกจะสร้างสำเนา"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tài liệu được lưu cục bộ. Nhập và xuất đều tạo bản sao."
          }
        }
      }
    },
