    "Edit UTF-8 text and Markdown. Highlight PDFs. Edit supported text in DOCX, XLSX, and PPTX documents.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Edit UTF-8 text and Markdown. Highlight PDFs. Edit supported text in DOCX, XLSX, and PPTX documents."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "UTF-8 텍스트와 Markdown을 편집하고 PDF를 강조할 수 있습니다. DOCX, XLSX, PPTX 문서의 지원되는 텍스트를 편집합니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "UTF-8テキストとMarkdownの編集、PDFのハイライト、DOCX・XLSX・PPTXの対応テキストの編集ができます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "编辑 UTF-8 文本和 Markdown，为 PDF 添加高亮，编辑 DOCX、XLSX 和 PPTX 中支持的文本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "編輯 UTF-8 文字與 Markdown、為 PDF 加上標示，並編輯 DOCX、XLSX 和 PPTX 中支援的文字。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifiez du texte UTF-8 et Markdown. Surlignez des PDF. Modifiez les textes pris en charge dans les fichiers DOCX, XLSX et PPTX."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bearbeite UTF-8-Text und Markdown. Markiere PDFs. Bearbeite unterstützte Texte in DOCX-, XLSX- und PPTX-Dokumenten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Edita texto UTF-8 y Markdown. Resalta PDF. Edita el texto compatible en documentos DOCX, XLSX y PPTX."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Edite texto UTF-8 e Markdown. Destaque PDFs. Edite o texto compatível em documentos DOCX, XLSX e PPTX."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifica testo UTF-8 e Markdown. Evidenzia PDF. Modifica il testo supportato nei documenti DOCX, XLSX e PPTX."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewerk UTF-8-tekst en Markdown. Markeer pdf’s. Bewerk ondersteunde tekst in DOCX-, XLSX- en PPTX-documenten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Edytuj tekst UTF-8 i Markdown. Wyróżniaj tekst w PDF. Edytuj obsługiwany tekst w dokumentach DOCX, XLSX i PPTX."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Upravujte text UTF-8 a Markdown. Zvýrazňujte PDF. Upravujte podporovaný text v dokumentech DOCX, XLSX a PPTX."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Редактируйте текст UTF-8 и Markdown. Выделяйте текст в PDF. Редактируйте поддерживаемый текст в документах DOCX, XLSX и PPTX."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Edit teks UTF-8 dan Markdown. Sorot PDF. Edit teks yang didukung dalam dokumen DOCX, XLSX, dan PPTX."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Edit teks UTF-8 dan Markdown. Serlahkan PDF. Edit teks yang disokong dalam dokumen DOCX, XLSX dan PPTX."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حرر نصوص UTF-8 وMarkdown. ميّز ملفات PDF. حرر النصوص المدعومة في مستندات DOCX وXLSX وPPTX."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עריכת טקסט UTF-8 ו-Markdown. הדגשת PDF. עריכת טקסט נתמך במסמכי DOCX,‏ XLSX ו-PPTX."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "UTF-8 टेक्स्ट और Markdown संपादित करें। PDF हाइलाइट करें। DOCX, XLSX और PPTX दस्तावेज़ों में समर्थित टेक्स्ट संपादित करें।"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แก้ไขข้อความ UTF-8 และ Markdown ไฮไลต์ PDF และแก้ไขข้อความที่รองรับในเอกสาร DOCX, XLSX และ PPTX"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sửa văn bản UTF-8 và Markdown. Tô sáng PDF. Sửa văn bản được hỗ trợ trong tài liệu DOCX, XLSX và PPTX."
          }
        }
      }
    },
